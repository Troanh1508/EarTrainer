<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-to-device transfer on Android 12+. Same content as backup_rules.xml:
    practice history (the Room database with its journal files) and settings (DataStore).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
