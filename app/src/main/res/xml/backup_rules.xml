<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup on Android 6 to 11 (Android 12+ reads data_extraction_rules.xml instead).
    Backs up practice history (the Room database with its journal files) and settings
    (the Preferences DataStore). Everything else can be rebuilt, so it is left out.
    Keep in sync with data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore" />
</full-backup-content>
