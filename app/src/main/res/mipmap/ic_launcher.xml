    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <clip-path android:pathData="M12,0h48a12,12 0,0 1,12 12v48a12,12 0,0 1,-12 12h-48a12,12 0,0 1,-12 -12v-48a12,12 0,0 1,12 -12z" />
    <group
        android:translateX="-18"
        android:translateY="-18">
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="108"
                    android:endY="108">
                    <item android:offset="0" android:color="#FF4355B9" />
                    <item android:offset="1" android:color="#FF2F3C8F" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Staff -->
        <path
            android:pathData="M24.99,63.41C34.18,63.08 42.84,54.4 55.83,52.75M24.99,67.91C34.18,67.58 42.84,58.9 55.83,57.25M24.99,72.41C34.18,72.08 42.84,63.4 55.83,61.75"
            android:strokeWidth="1.2"
            android:strokeColor="#FFFFFFFF"
            android:strokeAlpha="0.45"
            android:strokeLineCap="round" />
        <!-- Ear: outer rim, then inner fold and the flap in front of the opening -->
        <path
            android:pathData="M57.5,47C57,36.5 63,28.5 70.5,28.5C78.5,28.5 84,35 84,43.5C84,51 79.5,55 76.5,59C73.5,63 73,69.5 69.5,74C66.5,78 60.5,79.5 57,75.5"
            android:strokeWidth="4.6"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M64,46C64,40.5 67,37 70.5,37C74.5,37 76.5,40.5 76.5,43.5C76.5,48 73,50 71,53.5M62.5,57C65.5,56.5 67.5,59 66,62.5"
