<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon for Android 7.x, which has no adaptive icons: the background and foreground
  layers from drawable/ic_launcher_background.xml and ic_launcher_foreground.xml, cropped to the
  visible middle 72 of their 108 units and clipped to a rounded square. Android 8.0 and later use
  mipmap-anydpi-v26 instead.
-->
