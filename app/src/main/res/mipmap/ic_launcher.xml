        <group
            android:pivotX="33.3"
            android:pivotY="70.25"
            android:rotation="-24">
            <path
                android:fillColor="#FF8EF0DC"
                android:pathData="M29.3,70.25a4,3 0,1 0,8 0a4,3 0,1 0,-8 0z" />
        </group>
        <group
            android:pivotX="46"
            android:pivotY="59.9"
            android:rotation="-24">
            <path
                android:fillColor="#FF8EF0DC"
                android:pathData="M42,59.9a4,3 0,1 0,8 0a4,3 0,1 0,-8 0z" />
        </group>
        <path
            android:pathData="M36.3,70V58C36.6,60.4 39.3,61 38.8,64M49,59.6V47.6"
            android:strokeWidth="1.8"
            android:strokeColor="#FF8EF0DC"
