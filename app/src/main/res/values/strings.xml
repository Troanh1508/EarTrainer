<resources>
    <string name="app_name">Ear Trainer</string>

    <!-- Home -->
    <string name="home_tagline">Train your ears to recognise what you hear.</string>
    <string name="home_intervals_title">Interval Training</string>
    <string name="home_intervals_description">Hear two notes and name the distance between them.</string>
    <string name="home_chords_title">Chord Training</string>
    <string name="home_chords_description">Hear a chord and name its quality or inversion.</string>
    <string name="home_degrees_title">Scale Degrees</string>
    <string name="home_degrees_description">Hear a key, then name a note by its role in it.</string>
    <string name="home_progress_title">Your Progress</string>
    <string name="home_progress_description">See how accurately you recognise intervals, chords and scale degrees.</string>
    <string name="home_offline_note">Free and fully offline. More exercises are on the way.</string>
    <string name="home_sound_credit">Piano sound: Upright Piano KW from FreePats (CC0).</string>

    <!-- Interval training -->
    <string name="intervals_title">Interval Training</string>
    <string name="practice_open_settings">Practice settings</string>
    <string name="intervals_instruction">Listen to the two notes and identify the interval.</string>
    <string name="practice_question_number">Question %1$d · %2$s</string>
    <string name="practice_score">%1$d of %2$d correct</string>
    <string name="practice_score_empty">No answers yet</string>
    <string name="practice_play">Play</string>
    <string name="practice_replay">Replay</string>
    <string name="practice_stop">Stop</string>
    <string name="practice_listen_first">Play the notes to unlock the answers.</string>
    <string name="practice_playback_failed">Audio could not be played. Another app may be using audio, or the output device is unavailable. Try again.</string>
    <string name="practice_feedback_correct">Correct</string>
    <string name="practice_feedback_incorrect">Not quite</string>
    <string name="practice_feedback_your_answer">You answered %1$s.</string>
    <plurals name="intervals_semitones">
        <item quantity="one">%d semitone</item>
        <item quantity="other">%d semitones</item>
    </plurals>
    <string name="practice_next">Next question</string>
    <string name="practice_choice_correct">correct answer</string>
    <string name="practice_choice_incorrect">your answer, incorrect</string>

    <!-- Chord training -->
    <string name="chords_title">Chord Training</string>
    <string name="chords_instruction_quality">Listen to the chord and identify its quality.</string>
    <string name="chords_instruction_inversion">Listen to the chord and identify its inversion.</string>
    <!-- e.g. "C major · 1st inversion" -->
    <string name="chords_summary">%1$s %2$s · %3$s</string>
    <string name="chords_bass_root">Root in the bass</string>
    <string name="chords_bass_third">3rd in the bass</string>
    <string name="chords_bass_fifth">5th in the bass</string>
    <string name="chords_bass_seventh">7th in the bass</string>

    <!-- Scale degrees -->
    <string name="degrees_title">Scale Degrees</string>
    <string name="degrees_instruction">Listen to the key being set, then identify the scale degree of the final note.</string>
    <!-- e.g. "♭3 (Me) in C minor" -->
    <string name="degrees_summary">%1$s (%2$s) in %3$s</string>

    <!-- Interval settings -->
    <string name="settings_title">Practice Settings</string>
    <string name="settings_new_session_note">Changes are saved automatically and start a new practice session.</string>
    <string name="settings_intervals_title">Intervals</string>
    <string name="settings_intervals_description">Questions use only the intervals you select. Keep at least %1$d.</string>
    <string name="settings_select_all">Select all</string>
    <string name="settings_styles_title">How notes are played</string>
    <string name="settings_styles_description">Questions randomly use any of the selected styles. Keep at least one.</string>
    <string name="settings_choices_title">Answer choices</string>
    <string name="settings_choices_description">How many intervals to choose from in each question.</string>
    <string name="settings_choices_all">All</string>
    <string name="settings_restore_defaults">Restore defaults</string>

    <!-- Chord settings -->
    <string name="chord_settings_target_title">What to identify</string>
    <string name="chord_settings_target_description">Name the type of chord, or which chord tone is in the bass.</string>
    <string name="chord_settings_qualities_title">Chord types</string>
    <string name="chord_settings_qualities_description">Questions use only the chord types you select. Keep at least %1$d.</string>
    <string name="chord_settings_inversions_title">Include inversions</string>
    <string name="chord_settings_inversions_description">Also play chords with the 3rd, 5th or 7th in the bass.</string>
    <string name="chord_settings_inversions_always">Always on when identifying inversions.</string>

    <!-- Scale degree settings -->
    <string name="degree_settings_modes_title">Modes</string>
    <string name="degree_settings_modes_description">Questions randomly use any of the selected modes. Keep at least one.</string>
    <string name="degree_settings_degrees_title">Notes to identify</string>
    <string name="degree_settings_degrees_description">Only the seven notes of the key, or every note including chromatic ones.</string>
    <string name="degree_settings_key_title">Key</string>
    <string name="degree_settings_key_description">Practise in one familiar key, or a new key each question.</string>
    <string name="degree_settings_context_title">How the key is set</string>
    <string name="degree_settings_context_description">Played before each note so you can hear where home is.</string>

