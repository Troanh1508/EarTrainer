    <!-- Backup and restore -->
    <string name="backup_title">Backup &amp; Restore</string>
    <string name="backup_auto_title">Automatic backup</string>
    <string name="backup_auto_description">When backup is turned on in your phone settings, Android saves your history and settings to your Google account. They come back when you reinstall Ear Trainer or set up a new phone with the same account.</string>
    <string name="backup_export_title">Export to a file</string>
    <string name="backup_export_description">Save all your history and settings in one file. Keep it somewhere safe, or use it to move to another device, even one without a Google account.</string>
    <string name="backup_export_button">Export</string>
    <string name="backup_import_title">Import from a file</string>
    <string name="backup_import_description">Add the history from an exported file to this device. Answers that are already here are not added twice. Your settings are replaced by the ones in the file.</string>
