<resources>
    <string name="app_name">Ear Trainer</string>

    <!-- Home -->
    <string name="home_tagline">Train your ears to recognize what you hear.</string>
    <string name="home_intervals_title">Interval Training</string>
    <string name="home_intervals_description">Hear two notes and name the distance between them.</string>
    <string name="home_chords_title">Chord Training</string>
    <string name="home_chords_description">Hear a chord and name its quality or inversion.</string>
    <string name="home_degrees_title">Scale Degrees</string>
    <string name="home_degrees_description">Hear a key, then name a note by its role in it.</string>
    <string name="home_progressions_title">Chord Progressions</string>
    <string name="home_progressions_description">Hear a progression in a key and name its chords.</string>
    <string name="home_dictation_title">Melodic Dictation</string>
    <string name="home_dictation_description">Hear a short melody and write it down note by note.</string>
    <string name="home_rhythm_title">Rhythm</string>
    <string name="home_rhythm_description">Hear a rhythm and pick the matching notation.</string>
    <string name="home_progress_title">Your Progress</string>
    <string name="home_progress_description">See how accurately you recognize what you hear in each exercise.</string>
    <string name="home_backup_title">Backup &amp; Restore</string>
    <string name="home_backup_description">Keep your history and settings safe, or move them to another device.</string>
    <string name="home_offline_note">Free and fully offline. More exercises are on the way.</string>
    <string name="home_sound_credit">Sounds: Upright Piano KW and Spanish Classical Guitar from FreePats (CC0).</string>

