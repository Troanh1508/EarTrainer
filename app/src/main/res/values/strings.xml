    <!-- Scale degrees -->
    <string name="degrees_title">Scale Degrees</string>
    <string name="degrees_instruction">Listen to the key being set, then identify the scale degree of the final note.</string>
    <!-- e.g. "♭3 (Me) in C minor" -->
    <string name="degrees_summary">%1$s (%2$s) in %3$s</string>

    <!-- Chord progressions -->
    <string name="progressions_title">Chord Progressions</string>
    <string name="progressions_instruction">Listen to the progression and choose the chords you heard. It always starts on the tonic.</string>
    <!-- e.g. "I – vi – IV – V in C major (C – Am – F – G)" -->
    <string name="progressions_summary">%1$s in %2$s (%3$s)</string>

    <!-- Melodic dictation -->
    <string name="dictation_title">Melodic Dictation</string>
    <string name="dictation_instruction">Listen to the key being set, then write down the melody. It starts on the tonic, which is filled in for you. Tap any note to change it.</string>
    <!-- e.g. "1 – 2 – 3 – 1 (Do Re Mi Do) in C major" -->
    <string name="dictation_summary">%1$s (%2$s) in %3$s</string>
