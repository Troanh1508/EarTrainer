<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground ("Staff stream"): two rising notes on a curving staff that flows
  toward an ear. Everything sits inside the 66dp safe zone, so no launcher mask crops it. Also
  used as the monochrome layer for themed icons, where only its alpha counts. The legacy icons in
  mipmap/ repeat these paths; keep them in step.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Staff -->
    <path
        android:pathData="M24.99,63.41C34.18,63.08 42.84,54.4 55.83,52.75M24.99,67.91C34.18,67.58 42.84,58.9 55.83,57.25M24.99,72.41C34.18,72.08 42.84,63.4 55.83,61.75"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeLineCap="round" />
    <!-- Ear: outer rim, then inner fold and the flap in front of the opening -->
    <path
        android:pathData="M57.5,47C57,36.5 63,28.5 70.5,28.5C78.5,28.5 84,35 84,43.5C84,51 79.5,55 76.5,59C73.5,63 73,69.5 69.5,74C66.5,78 60.5,79.5 57,75.5"
        android:strokeWidth="4.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M64,46C64,40.5 67,37 70.5,37C74.5,37 76.5,40.5 76.5,43.5C76.5,48 73,50 71,53.5M62.5,57C65.5,56.5 67.5,59 66,62.5"
        android:strokeWidth="3.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Notes: an eighth note on the bottom line, then a quarter note on the middle line -->
    <group
        android:pivotX="33.3"
        android:pivotY="70.25"
        android:rotation="-24">
        <path
            android:fillColor="#FF8EF0DC"
            android:pathData="M29.3,70.25a4,3 0,1 0,8 0a4,3 0,1 0,-8 0z" />
    </group>
    <group
        android:pivotX="46"
        android:pivotY="59.9"
        android:rotation="-24">
        <path
            android:fillColor="#FF8EF0DC"
            android:pathData="M42,59.9a4,3 0,1 0,8 0a4,3 0,1 0,-8 0z" />
